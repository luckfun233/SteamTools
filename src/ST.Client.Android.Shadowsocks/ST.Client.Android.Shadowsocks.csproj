<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <IsBindingProject>true</IsBindingProject>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <AndroidCodegenTarget>XAJavaInterop1</AndroidCodegenTarget>
    <!--<GeneratePackageOnBuild>true</GeneratePackageOnBuild>-->
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AigioL/xamarin-bindings</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AigioL/xamarin-bindings.git</RepositoryUrl>
    <PackageTags>Shadowsocks Shadowsocks-Android Xamarin Plugin Binding</PackageTags>
    <Product>Shadowsocks</Product>
    <Company />
    <PackageId>XAB.Shadowsocks</PackageId>
    <Title>Android Binding Library - Shadowsocks</Title>
    <Authors>https://github.com/AigioL</Authors>
    <Description>
      Shadowsocks Binding for Android. https://github.com/shadowsocks/shadowsocks-android

      Commonly Used Types:
      net.steampp.app.shadowsocks -&gt; Shadowsocks
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <AndroidLibrary Include="Jars\*.aar" Bind="true" />
    <TransformFile Include="Transforms\*.xml" />
    <None Remove="Transforms\*.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" />
  </ItemGroup>
</Project>
